[Unit]
Description=NitroSense for Linux hardware service (Acer WMI: fans, keyboard lighting, power plans)
# Not ordered after power-profiles-daemon: its unit runs After=multi-user.target, so ordering
# against it while WantedBy=multi-user.target is a cycle and systemd drops this job at boot.
# powerprofilesctl reaches ppd through D-Bus activation anyway.
After=systemd-modules-load.service nitrosense-acpi-call.service
Wants=systemd-modules-load.service nitrosense-acpi-call.service

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe -q acpi_call
ExecStart=/opt/nitrosense/bin/nitrosensed
Restart=on-failure
RestartSec=3
RuntimeDirectory=nitrosense
RuntimeDirectoryMode=0755
StateDirectory=nitrosense
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
